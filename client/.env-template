# Database (matches docker-compose.yml port mapping)
DATABASE_URL=postgresql://pulse:pulse@localhost:5433/pulse_survey

# App
PORT=3001
NODE_ENV=development

# CORS — allow the Vite dev server to call the API
CORS_ORIGIN=http://localhost:5173

# "This week" definition — pull into config rather than hardcoding,
# so it's visible as a config choice, matching your SPEC.md decision
WEEK_STRATEGY=calendar   # or 'rolling'
